---
import { formatShortDate, ytThumb, ytWatch } from '../lib/format';

interface Props {
  id: string;
  title: string;
  date?: Date;
}

const { id, title, date } = Astro.props;
---

<a class="video card" href={ytWatch(id)} target="_blank" rel="noopener">
  <div class="thumb">
    <img src={ytThumb(id)} alt="" width="480" height="360" loading="lazy" decoding="async" />
    <span class="play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    </span>
  </div>
  <div class="meta">
    <h3>{title}</h3>
    {date && <time datetime={date.toISOString()}>{formatShortDate(date)}</time>}
  </div>
</a>

<style>
  .video {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .video:hover {
    transform: translateY(-4px);
    border-color: var(--orange);
  }

  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .video:hover .thumb img {
    transform: scale(1.04);
  }

  .play {
    position: absolute;
    inset: auto 0.8rem 0.8rem auto;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--orange);
    color: #120a04;
    padding-left: 2px;
  }

  .meta {
    padding: 1rem 1.1rem 1.2rem;
  }

  h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 700;
  }

  time {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
