---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const channels = [
  {
    label: 'Instagram 私訊',
    note: '最快的聯絡方式',
    value: '@dsband_official',
    href: site.social.instagram,
    primary: true,
  },
  { label: 'Email', note: '正式邀約或合作提案', value: site.email, href: `mailto:${site.email}` },
  { label: 'YouTube', note: '看我們的作品', value: '@dsband777', href: site.social.youtube },
  { label: 'Threads', note: '日常動態', value: '@dsband_official', href: site.social.threads },
];

const checklist = ['活動名稱與性質', '日期、時間與預計演出長度', '地點（室內／戶外）與現場音響設備', '預計參與人數', '聯絡人與聯絡方式'];
---

<Base title="邀約合作" description={`邀請 ${site.name} ${site.nameZh} 演出或合作：Instagram 私訊或來信 ${site.email}。`}>
  <header class="page-hero">
    <div class="container">
      <span class="eyebrow">Booking</span>
      <h1 class="display"><span class="zh">邀約合作</span></h1>
      <p class="lead">表演、合作、邀約，都歡迎找我們聊聊！</p>
    </div>
  </header>

  <section class="section">
    <div class="container layout">
      <ul class="channels">
        {
          channels.map((c) => (
            <li>
              <a
                class:list={['channel card', { primary: c.primary }]}
                href={c.href}
                target={c.href.startsWith('mailto:') ? undefined : '_blank'}
                rel="noopener">
                <span class="c-label">{c.label}</span>
                <span class="c-value">{c.value}</span>
                <span class="c-note">{c.note}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <aside class="card tips">
        <h2>邀約時可以先告訴我們</h2>
        <ol>
          {checklist.map((item) => <li>{item}</li>)}
        </ol>
        <p>資訊越完整，我們越快回覆你。</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 820px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }

  .channels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    gap: 1rem;
  }

  .channel {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1.4rem 1.5rem;
    text-decoration: none;
    height: 100%;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .channel:hover {
    border-color: var(--orange);
    transform: translateY(-3px);
  }

  .channel.primary {
    background: var(--orange);
    border-color: var(--orange);
    color: #120a04;
  }

  .channel.primary .c-note {
    color: #3a1a05;
  }

  .c-label {
    font-weight: 900;
    font-size: 1.15rem;
  }

  .c-value {
    font-weight: 700;
    word-break: break-all;
  }

  .c-note {
    font-size: 0.88rem;
    color: var(--muted);
  }

  .tips {
    padding: 1.6rem 1.8rem;
  }

  .tips h2 {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    font-weight: 900;
  }

  .tips ol {
    margin: 0 0 1rem;
    padding-left: 1.3rem;
    color: #d9d3ca;
  }

  .tips p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
