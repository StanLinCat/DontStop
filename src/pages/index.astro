---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import EventCard from '../components/EventCard.astro';
import logo from '../assets/logo.png';
import { site } from '../data/site';
import { byDateDesc, isUpcoming, ytEmbed } from '../lib/format';

const videos = await getCollection('videos');
const featured = videos.find((v) => v.data.featured) ?? videos.sort(byDateDesc)[0];
const latest = videos
  .filter((v) => v.id !== featured.id && v.data.category !== 'other' && v.data.date)
  .sort(byDateDesc)
  .slice(0, 6);

const events = await getCollection('events');
const upcoming = events.filter((e) => isUpcoming(e.data.date)).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const spotlight = upcoming[0] ?? events.sort(byDateDesc)[0];

const marquee = ["DON'T STOP", ...site.slogan, site.tagline];
---

<Base>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">{site.tagline}・嘉義東石</span>
        <h1>
          <span class="display hero-title">Don't<br />Stop</span>
          <span class="hero-zh">{site.nameZh}</span>
        </h1>
        <p class="hero-slogan">
          {site.slogan.map((line) => <span>{line}</span>)}
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#featured">看最新 MV</a>
          <a class="btn btn-ghost" href="/contact/">邀約演出</a>
        </div>
      </div>
      <div class="hero-logo">
        <Image src={logo} alt={`${site.name} 樂團標誌`} width={320} height={320} loading="eager" />
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <span>
            {marquee.map((t) => (
              <>
                {t}
                <b>✦</b>
              </>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <section class="section" id="featured">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Featured</span>
          <h2 class="display"><span class="zh">主打作品</span></h2>
        </div>
        <a class="link-arrow" href={site.social.youtube} target="_blank" rel="noopener">YouTube 頻道 →</a>
      </div>
      <div class="player">
        <iframe
          src={ytEmbed(featured.id)}
          title={featured.data.title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </div>
      <p class="player-caption">{featured.data.title}</p>
    </div>
  </section>

  {
    spotlight && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <div>
              <span class="eyebrow">{upcoming.length ? 'Next Show' : 'Latest Show'}</span>
              <h2 class="display">
                <span class="zh">{upcoming.length ? '近期演出' : '最近一場演出'}</span>
              </h2>
            </div>
            <a class="link-arrow" href="/events/">所有演出 →</a>
          </div>
          <EventCard event={spotlight} />
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Videos</span>
          <h2 class="display"><span class="zh">最新影音</span></h2>
        </div>
        <a class="link-arrow" href="/videos/">全部影音 →</a>
      </div>
      <div class="grid">
        {latest.map((v) => <VideoCard id={v.id} title={v.data.title} date={v.data.date} />)}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta-inner">
      <div>
        <h2 class="display cta-title">Let's Play<br />Together</h2>
        <p>活動演出、聚會邀約、音樂合作，都歡迎和我們聊聊。</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-dark" href="/contact/">邀約合作</a>
        <a class="btn btn-outline-dark" href={site.social.instagram} target="_blank" rel="noopener">私訊 Instagram</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 8rem) clamp(3rem, 8vw, 6rem);
    background:
      radial-gradient(50% 70% at 78% 45%, rgba(239, 106, 28, 0.35), transparent 70%),
      repeating-linear-gradient(-62deg, transparent 0 34px, rgba(255, 255, 255, 0.018) 34px 36px),
      var(--bg);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 2rem;
  }

  h1 {
    margin: 0;
  }

  .hero-title {
    display: block;
    font-size: clamp(4.5rem, 14vw, 10rem);
    color: var(--amber);
    text-shadow: 6px 6px 0 var(--orange-deep);
  }

  .hero-zh {
    display: block;
    margin-top: 1.2rem;
    font-size: clamp(1.4rem, 3.5vw, 2.2rem);
    font-weight: 900;
    letter-spacing: 0.3em;
  }

  .hero-slogan {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.2rem;
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    color: var(--muted);
    margin: 1rem 0 2rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .hero-logo {
    justify-self: center;
    width: min(100%, 360px);
    animation: float 6s ease-in-out infinite;
  }

  .hero-logo img {
    width: 100%;
    border-radius: 50%;
    box-shadow: 0 30px 80px rgba(239, 106, 28, 0.35);
  }

  @keyframes float {
    50% {
      transform: translateY(-12px) rotate(-3deg);
    }
  }

  @media (max-width: 820px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-logo {
      order: -1;
      width: 180px;
      justify-self: start;
    }
  }

  .marquee {
    background: var(--orange);
    color: #120a04;
    overflow: hidden;
    transform: rotate(-1.5deg);
    margin-block: -0.6rem;
    position: relative;
    z-index: 2;
    border-block: 3px solid #000;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: scroll 32s linear infinite;
  }

  .marquee-track span {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    padding: 0.7rem 0.7rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .marquee-track b {
    font-weight: 400;
    color: #fff3dc;
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .player {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: #000;
  }

  .player iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .player-caption {
    margin: 1rem 0 0;
    color: var(--muted);
  }

  .cta {
    background: var(--orange);
    color: #120a04;
    padding-block: clamp(3.5rem, 8vw, 5.5rem);
  }

  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta-title {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
  }

  .cta p {
    margin: 1rem 0 0;
    font-weight: 700;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .btn-dark {
    background: #120a04;
    color: var(--amber);
  }

  .btn-dark:hover {
    background: #000;
  }

  .btn-outline-dark {
    border-color: #120a04;
    color: #120a04;
  }

  .btn-outline-dark:hover {
    background: rgba(0, 0, 0, 0.08);
  }
</style>
