---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const members = (await getCollection('members')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(members.map(async (m) => ({ m, Content: (await render(m)).Content })));
---

<Base title="關於" description={`認識 ${site.name} ${site.nameZh}：${site.tagline}，${site.slogan.join('，')}。`}>
  <header class="page-hero">
    <div class="container">
      <span class="eyebrow">About</span>
      <h1 class="display"><span class="zh">關於我們</span></h1>
    </div>
  </header>

  <section class="section">
    <div class="container story">
      <blockquote>
        {site.slogan.map((line) => <span>{line}</span>)}
      </blockquote>
      <div class="prose">
        <!-- TODO: 請樂團確認/補充成立年份、成員組成與團名由來 -->
        <p>
          Don't Stop（東石大樂團）是一群來自嘉義東石、在西海岸長大的年輕人組成的樂團。我們相信音樂能改變一個人，也能讓一個地方重新有活力。
        </p>
        <p>
          我們的作品以台語和華語創作為主，包括〈感謝神 I Thank God〉、〈祢是我的主〉，以及和 Top Worship 合作的〈Last Battle｜無名的傳道者IV 台語版〉。除了音樂，我們也製作訪談節目《Don't Stop Talk》，和大家聊夢想、興趣，還有逆風時怎麼繼續往前。
        </p>
        <p>
          樂團與<a href={site.partner.url} target="_blank" rel="noopener">{site.partner.name}</a>長期合作，一起舉辦西海岸聖誕文化節感恩音樂祭等活動，用音樂陪伴在地的下一代。
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Members</span>
          <h2 class="display"><span class="zh">團員</span></h2>
        </div>
      </div>
      <div class="members">
        {
          rendered.map(({ m, Content }) => (
            <article class="member card">
              {m.data.photo && (
                <Image src={m.data.photo} alt={`${m.data.name}${m.data.nickname ? `（${m.data.nickname}）` : ''}`} width={400} height={400} />
              )}
              <div class="member-body">
                <p class="member-role">{m.data.role}</p>
                <h3>
                  {m.data.name}
                  {m.data.nickname && <span class="nick">{m.data.nickname}</span>}
                </h3>
                <div class="prose">
                  <Content />
                </div>
              </div>
            </article>
          ))
        }
        <div class="member card more">
          <p>更多團員介紹<br />即將公開</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .story {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  @media (max-width: 820px) {
    .story {
      grid-template-columns: 1fr;
    }
  }

  blockquote {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    font-weight: 900;
    line-height: 1.3;
    color: var(--amber);
    border-left: 6px solid var(--orange);
    padding-left: 1.4rem;
  }

  .prose {
    color: #d9d3ca;
  }

  .prose a {
    color: var(--amber);
  }

  .members {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  }

  .member img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .member-body {
    padding: 1.3rem 1.4rem 1.5rem;
  }

  .member-role {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--amber);
    letter-spacing: 0.08em;
  }

  .member h3 {
    margin: 0.2rem 0 0.8rem;
    font-size: 1.5rem;
    font-weight: 900;
  }

  .nick {
    margin-left: 0.6rem;
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--orange);
  }

  .member .prose {
    font-size: 0.95rem;
  }

  .more {
    display: grid;
    place-items: center;
    min-height: 240px;
    border-style: dashed;
    background: transparent;
    text-align: center;
    color: var(--muted);
    font-weight: 700;
  }
</style>
